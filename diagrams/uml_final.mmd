classDiagram
    class Task {
        +str title
        +int duration_minutes
        +Priority priority
        +str preferred_time
        +Frequency frequency
        +bool completed
        +date due_date
        +mark_complete(today) Task
    }

    class Pet {
        +str name
        +str species
        +list~Task~ tasks
        +add_task(task) None
        +remove_task(task) None
        +get_pending_tasks() list~Task~
    }

    class Owner {
        +str name
        +int available_minutes_per_day
        +dict preferences
        +list~Pet~ pets
        +add_pet(pet) None
        +get_all_tasks() list~Task~
    }

    class Scheduler {
        +Owner owner
        +date today
        +list~Task~ skipped
        -list _reasons
        +sort_by_time(tasks) list~Task~
        +filter_tasks(pet_name, completed) list~Task~
        +generate_plan() list~Task~
        +detect_conflicts() list~tuple~
        +conflict_warnings() list~str~
        +mark_task_complete(task) Task
        +pet_name_for(task) str
        +explain_plan() str
        -_pet_of(task) Pet
    }

    class Priority {
        <<Literal>>
        high
        medium
        low
    }

    class Frequency {
        <<Literal>>
        once
        daily
        weekly
    }

    Owner "1" *-- "0..*" Pet : has
    Pet "1" *-- "0..*" Task : has
    Scheduler --> Owner : reads tasks via get_all_tasks()
    Scheduler ..> Pet : finds owning pet, adds next recurrence
    Scheduler ..> Task : plans, sorts, filters, completes
    Task ..> Task : mark_complete() returns next copy
    Task --> Priority
    Task --> Frequency
